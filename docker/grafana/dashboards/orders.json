          "legendFormat": "{{uri}}",
          "range": true,
          "refId": "A"
        }
      ],
      "pluginVersion": "11.1.0"
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Saude dos componentes",
      "description": "1 = alcancavel, 0 = nao. O /actuator/health responde a pergunta agora e nao guarda historico; o gauge e o que torna 'ficou fora quatro minutos na terca' uma pergunta respondivel.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 6,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "mappings": [],
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "lineInterpolation": "stepAfter"
          },
          "max": 1,
          "min": 0
        },
        "overrides": []
