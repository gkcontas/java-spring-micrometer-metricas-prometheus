    {
      "id": 9,
      "type": "timeseries",
      "title": "Heap da JVM",
      "description": "Metrica tecnica, de graca com o Actuator. Diz se o processo esta vivo - nao diz se o produto funciona.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 6,
        "w": 9,
        "x": 6,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "lineWidth": 2,
